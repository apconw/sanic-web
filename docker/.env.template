# 服务名称
COMPOSE_PROJECT_NAME=aix-db

# JWT 签名密钥（必填，无默认值，留空 docker-compose up 会直接报错）
# 生成方式: python3 -c "import secrets; print(secrets.token_hex(32))"
# 注意：所有 worker/副本必须使用相同的值；更换密钥会使已签发的 token 全部失效，用户需重新登录
JWT_SECRET_KEY=

# 后端服务端口&工作线程
SERVER_PORT=8088
SERVER_WORKERS=2

# 前端 PageAgent 开关（运行时注入）
VITE_ENABLE_PAGE_AGENT=false

# 深度问数HML 模型最大长度
LLM_MAX_TOKENS=65536
